{
  "manifestVersion": 2,
  "id": "slack",
  "name": "Slack",
  "version": "0.2.0",
  "description": "Slack unread count in Orca's status bar and a desktop notification when new messages arrive.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "statusBarItems": [
      {
        "id": "slack",
        "text": "Slack",
        "icon": "bell",
        "tooltip": "No unread Slack messages"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    }
  ]
}
